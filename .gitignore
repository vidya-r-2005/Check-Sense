# Data rules (MASTER_SPEC.md: never commit raw or derived requirement text without redistribution rights)
data/raw/*
!data/raw/.gitkeep
data/interim/*.jsonl
!data/interim/.gitkeep
!data/interim/pure_filtering_stats.json
data/processed/*
!data/processed/.gitkeep
data/gold/*.jsonl
data/gold/*.csv
!data/gold/.gitkeep
!data/gold/sample_manifest.json
!data/gold/annotations_template.csv

# Models & weights (MASTER_SPEC.md: never commit model weights)
models/*
!models/.gitkeep
*.joblib

